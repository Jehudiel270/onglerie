# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_DEMO_MODE=true

# Neon PostgreSQL : pooled runtime endpoint and direct endpoint for Drizzle migrations.
# Keep these separate from the platform-managed MySQL DATABASE_URL.
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=

# Better Auth and server-side OTP HMAC pepper: generate with `openssl rand -base64 32` and keep private.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Salon profile; configure only with information supplied by the owner.
NUXT_PUBLIC_SITE_NAME=Votre onglerie
NUXT_PUBLIC_SALON_PHONE=
NUXT_PUBLIC_SALON_WHATSAPP=
NUXT_PUBLIC_SALON_ADDRESS=
NUXT_PUBLIC_SALON_CITY=
NUXT_PUBLIC_SALON_EMAIL=
NUXT_PUBLIC_SALON_INSTAGRAM=

# Booking hold and cron service.
BOOKING_HOLD_MINUTES=10
CRON_SECRET=

# FedaPay: use sandbox credentials until verified; choose sandbox or production.
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Cloudinary (API secret stays server-only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Cloud API; the template names must exist and be approved in Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=
WHATSAPP_TEMPLATE_PAYMENT_REVIEW=
WHATSAPP_TEMPLATE_BOOKING_REMINDER=
WHATSAPP_TEMPLATE_CONTACT_MESSAGE=
WHATSAPP_TEMPLATE_BOOKING_RECOVERY=

# Interchangeable email adapter; no vendor is assumed.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# One-time owner bootstrap inputs; never commit actual values.
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
ALLOW_OWNER_BOOTSTRAP=
BOOTSTRAP_SALON_NAME=
BOOTSTRAP_SALON_SLUG=
BOOTSTRAP_SALON_CITY=
